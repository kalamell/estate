# โดเมนที่ชี้มาที่เซิร์ฟเวอร์นี้ (ไม่ต้องใส่ https://)
DOMAIN=estate.example.com

# บัญชีผู้ดูแลแพลตฟอร์ม (สร้างตอนเริ่มระบบครั้งแรก — เปลี่ยนรหัสผ่านทันทีหลังเข้าใช้)
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=change-this-strong-password

# กุญแจเข้ารหัสข้อมูลลับ (ยาว ≥ 32 ตัว) — ถ้าไม่ตั้ง ระบบสร้างไฟล์ /data/secret.key ให้ และต้องสำรองไฟล์นั้นไว้
# สร้างได้ด้วย: openssl rand -hex 32
APP_SECRET_KEY=

# เก็บสำรองข้อมูลย้อนหลังกี่วัน
BACKUP_KEEP_DAYS=14
